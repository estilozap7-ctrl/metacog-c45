{
  "datasets": [
    "iris",
    "wine",
    "breast_cancer",
    "adult"
  ],
  "folds": 5,
  "master_seed": 42,
  "parameter_grid": {
    "theta_accept": [0.15, 0.20, 0.25, 0.30, 0.35, 0.40],
    "theta_reject": [0.01, 0.03, 0.05, 0.07, 0.10, 0.12],
    "gamma": [0.0, 0.10, 0.15, 0.20, 0.30, 0.40, 0.50]
  },
  "constraints": {
    "reject_less_than_accept": true
  },
  "utility": {
    "complexity_penalty_weight": 0.20,
    "target_complexity_ratio": 0.40,
    "stump_penalty": 1.0
  }
}
